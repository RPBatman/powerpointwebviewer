<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">

  <!-- Never change this Id: slides that already contain the add-in find it by this value. -->
  <Id>f4013c8d-7276-4ecc-af95-cd22c0783867</Id>
  <!-- When releasing, bump Version AND the ?v= on SourceLocation to the same value. -->
  <Version>1.4.0.0</Version>
  <ProviderName>RPBatman</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>

  <DisplayName DefaultValue="Live Website Viewer"/>
  <Description DefaultValue="Embed and display live websites directly inside PowerPoint slides. Each slide can have its own URL."/>

  <IconUrl DefaultValue="https://rpbatman.github.io/powerpointwebviewer/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://rpbatman.github.io/powerpointwebviewer/icon-80.png"/>
  <SupportUrl DefaultValue="https://github.com/RPBatman/powerpointwebviewer"/>

  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://rpbatman.github.io/powerpointwebviewer/viewer.html?v=1.4.0.0"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
